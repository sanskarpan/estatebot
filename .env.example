# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/estatebot.db
INDEX_PATH=data/index
RAW_SNAPSHOT_DIR=data/raw
SEED_CORPUS_PATH=data/seed_corpus.json
SEED_ON_EMPTY=true
LOG_LEVEL=INFO

# OpenRouter. Leave blank for deterministic data-only mode.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_PRIMARY=google/gemma-4-31b-it:free
OPENROUTER_MODEL_FALLBACK_1=z-ai/glm-5.2:free
OPENROUTER_MODEL_FALLBACK_2=minimax/minimax-m3:free
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=EstateBot

# Retrieval / generation
RETRIEVAL_MODE=bm25_only
MAX_RETRIEVAL_CHUNKS=8
CHAT_HISTORY_TURNS=8
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=300
LLM_ATTEMPT_TIMEOUT_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=800

# Scraping
SCRAPER_USER_AGENT=EstateBot-Assignment-Scraper/1.0 (+https://github.com/your-user/estatebot; educational use)
SCRAPE_DELAY_SECONDS=2
SCRAPE_CONNECT_TIMEOUT_SECONDS=10
SCRAPE_READ_TIMEOUT_SECONDS=20
SCRAPE_MAX_RETRIES=3
MAX_DARGLOBAL_PRESS=25
MAX_WASALT_LISTINGS=400
MAX_PAGES_PER_CATEGORY=5
SCRAPE_CACHE_ENABLED=true

# Frontend/API development
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
